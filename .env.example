# Resend API key. Without it, /api/appointment logs submissions to the
# console and returns success — the form works locally with zero setup.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# "From" address used to send appointment emails. Must be on a domain
# verified in Resend for production; onboarding@resend.dev works for testing.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where appointment request emails are delivered.
DOCTOR_EMAIL_TO=doctor@example.com

# Public site URL, used for metadata/Open Graph/sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
